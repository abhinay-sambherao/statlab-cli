#!/usr/bin/env python3
"""
StatLab AI – Command Line Interface
====================================
Run statistical analyses on large datasets directly from the terminal.
No file size limits, no browser uploads — pure terminal power.

Usage:
    ./statlab upload data.csv
    ./statlab describe data.csv --columns col1 col2
    ./statlab ttest data.csv --group1 male --group2 female --value score
    ./statlab anova data.csv --dv value --factor group
    ./statlab regression data.csv --dv price --predictors size rooms
    ./statlab kmeans data.csv --clusters 3 --columns col1 col2
    ./statlab pca data.csv
    ./statlab monte-carlo --simulations 10000
    ./statlab report results.json --format html
    ./statlab batch config.json
"""

import argparse
import json
import sys
import os
from pathlib import Path
from typing import List, Optional

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import pandas as pd
import numpy as np


def load_data(path: str) -> pd.DataFrame:
    ext = Path(path).suffix.lower()
    if not Path(path).exists():
        print(f"Error: File not found: {path}")
        sys.exit(1)

    size_mb = Path(path).stat().st_size / (1024 * 1024)
    print(f"Loading: {path} ({size_mb:.1f} MB)")

    if ext == ".csv":
        df = pd.read_csv(path, low_memory=False)
    elif ext == ".tsv":
        df = pd.read_csv(path, sep="\t", low_memory=False)
    elif ext in (".xlsx", ".xls"):
        df = pd.read_excel(path)
    elif ext == ".json":
        df = pd.read_json(path)
    elif ext == ".parquet":
        df = pd.read_parquet(path)
    elif ext == ".feather":
        df = pd.read_feather(path)
    else:
        print(f"Unsupported format: {ext}")
        print("   Supported: .csv, .tsv, .xlsx, .json, .parquet, .feather")
        sys.exit(1)

    print(f"Loaded: {len(df):,} rows x {len(df.columns)} columns")
    return df


def cmd_upload(args):
    df = load_data(args.file)
    print(f"\nPreview (first 5 rows):")
    print(df.head().to_string())
    print(f"\nColumns:")
    for col in df.columns:
        dtype = df[col].dtype
        missing = df[col].isna().sum()
        print(f"   {col:30s} {str(dtype):10s} missing={missing}")


def cmd_describe(args):
    df = load_data(args.file)
    cols = args.columns or df.select_dtypes(include=[np.number]).columns.tolist()
    if args.json:
        from statistical.descriptive import DescriptiveStats
        result = DescriptiveStats.compute(df, columns=cols)
        print(json.dumps(result, indent=2, default=str))
    else:
        print("\nDescriptive Statistics")
        print("=" * 70)
        desc = df[cols].describe().to_string()
        print(desc)


def cmd_normality(args):
    df = load_data(args.file)
    from statistical.normality import NormalityTests
    result = NormalityTests.all_tests(df[args.column])
    print(f"\n{'='*50}")
    print(f"  Normality Tests: {args.column}")
    print(f"{'='*50}")
    for test_name, test_result in result.get('results', {}).items():
        if isinstance(test_result, dict):
            stat = test_result.get('statistic', 0)
            p = test_result.get('p_value', 0)
            sig = "NON-NORMAL" if test_result.get('significant') else "normal"
            print(f"  {test_name:25s}  stat={stat:.4f}  p={p:.4f}  ({sig})")


def cmd_ttest(args):
    df = load_data(args.file)
    from statistical.hypothesis import HypothesisTests
    if args.paired:
        result = HypothesisTests.paired_t(df[args.group1], df[args.group2])
    else:
        result = HypothesisTests.independent_t(df[args.group1], df[args.group2])
    print(f"\n{'='*50}")
    print(f"  {result['test']}")
    print(f"{'='*50}")
    print(f"  t-statistic:  {result['statistic']:.6f}")
    print(f"  p-value:      {result['p_value']:.6f}")
    print(f"  significant:  {'Yes' if result.get('significant') else 'No'}")
    if 'cohens_d' in result:
        print(f"  Cohen's d:    {result['cohens_d']:.4f}")
    print(f"\n  {result.get('interpretation', '')}")


def cmd_anova(args):
    df = load_data(args.file)
    from statistical.anova import ANOVA
    result = ANOVA.one_way(df, args.dv, args.factor)
    print(f"\n{'='*50}")
    print(f"  {result['test']}")
    print(f"{'='*50}")
    print(f"  F-statistic:  {result['f_statistic']:.6f}")
    print(f"  p-value:      {result['p_value']:.6f}")
    print(f"  eta-squared:  {result.get('eta_squared', 0):.4f}")
    print(f"  significant:  {'Yes' if result.get('significant') else 'No'}")
    print(f"\n  Group means:")
    for name, mean in result.get('group_means', {}).items():
        print(f"    {name}: {mean:.4f}")


def cmd_regression(args):
    df = load_data(args.file)
    from statistical.regression import Regression
    predictors = args.predictors or df.select_dtypes(include=[np.number]).columns.tolist()[:3]
    if args.dv in predictors:
        predictors.remove(args.dv)
    result = Regression.linear(df, args.dv, predictors)
    print(f"\n{'='*50}")
    print(f"  {result['test']}")
    print(f"{'='*50}")
    print(f"  R-squared:    {result['r_squared']:.6f}")
    print(f"  Adj. R-sq:    {result['adj_r_squared']:.6f}")
    print(f"  RMSE:         {result['rmse']:.6f}")
    print(f"  F-stat:       {result.get('f_statistic', 0):.4f}")
    print(f"\n  Coefficients:")
    for c in result.get('coefficients', []):
        sig = "***" if c.get('significant') else ""
        print(f"    {c['variable']:25s} {c['coefficient']:10.6f}  p={c.get('p_value', 0):.4f} {sig}")


def cmd_kmeans(args):
    df = load_data(args.file)
    from statistical.machine_learning import MachineLearning
    result = MachineLearning.kmeans(df, n_clusters=args.clusters, columns=args.columns)
    print(f"\n{'='*50}")
    print(f"  {result['test']}")
    print(f"{'='*50}")
    print(f"  Clusters:     {result['n_clusters']}")
    print(f"  Silhouette:   {result['silhouette_score']:.4f}")
    print(f"  Inertia:      {result['inertia']:.2f}")
    print(f"\n  Cluster sizes:")
    for k, v in result.get('cluster_sizes', {}).items():
        print(f"    Cluster {k}: {v} samples")


def cmd_pca(args):
    df = load_data(args.file)
    from statistical.advanced import AdvancedAnalysis
    result = AdvancedAnalysis.pca(df, n_components=args.components)
    print(f"\n{'='*50}")
    print(f"  {result['test']}")
    print(f"{'='*50}")
    print(f"  Components:   {result['n_components']}")
    print(f"  Total Var:    {result['total_variance_explained']:.4f}")
    print(f"\n  Variance explained:")
    for i, ev in enumerate(result.get('explained_variance_ratio', [])):
        cum = sum(result['explained_variance_ratio'][:i+1])
        print(f"    PC{i+1}: {ev:.4f} ({ev*100:.1f}%) [cumulative: {cum*100:.1f}%]")


def cmd_monte_carlo(args):
    from statistical.simulation import Simulation
    result = Simulation.monte_carlo(
        n_simulations=args.simulations,
        n_samples=args.samples,
        distribution=args.distribution,
    )
    print(f"\n{'='*50}")
    print(f"  {result['test']}")
    print(f"{'='*50}")
    print(f"  Mean of means: {result['mean_of_means']:.6f}")
    print(f"  SE of means:   {result['std_of_means']:.6f}")
    print(f"  95% CI:        [{result['percentiles']['2.5']:.4f}, {result['percentiles']['97.5']:.4f}]")


def cmd_correlation(args):
    df = load_data(args.file)
    from statistical.correlation import Correlation
    cols = args.columns or df.select_dtypes(include=[np.number]).columns.tolist()
    method = args.method or 'pearson'
    result = Correlation.matrix(df, columns=cols, method=method)
    print(f"\n{'='*50}")
    print(f"  Correlation Matrix ({method})")
    print(f"{'='*50}")
    import pandas as pd
    matrix = result.get('correlation_matrix', {})
    if matrix:
        corr_df = pd.DataFrame(matrix)
        print(corr_df.to_string())


def cmd_report(args):
    with open(args.file) as f:
        results = json.load(f)
    from utils.report_generator import ReportGenerator
    if isinstance(results, dict):
        results = [results]
    if args.format == "html":
        html = ReportGenerator.generate_html(results)
        output = args.output or "statlab_report.html"
        with open(output, "w") as f:
            f.write(html)
        print(f"Report saved: {output}")
    elif args.format == "pdf":
        html = ReportGenerator.generate_html(results)
        pdf = ReportGenerator.generate_pdf(html)
        output = args.output or "statlab_report.pdf"
        with open(output, "wb") as f:
            f.write(pdf)
        print(f"Report saved: {output}")
    else:
        print("Formats: html, pdf")


def cmd_batch(args):
    with open(args.config) as f:
        config = json.load(f)
    df = load_data(config["file"])
    results = {}

    for analysis in config.get("analyses", []):
        atype = analysis["type"]
        params = analysis.get("params", {})
        print(f"\nRunning: {atype}...")

        try:
            if atype == "descriptive":
                from statistical.descriptive import DescriptiveStats
                results[atype] = DescriptiveStats.compute(df, **params)
            elif atype == "ttest":
                from statistical.hypothesis import HypothesisTests
                results[atype] = HypothesisTests.independent_t(df[params["col1"]], df[params["col2"]])
            elif atype == "anova":
                from statistical.anova import ANOVA
                results[atype] = ANOVA.one_way(df, params["dv"], params["factor"])
            elif atype == "regression":
                from statistical.regression import Regression
                results[atype] = Regression.linear(df, params["dv"], params["predictors"])
            elif atype == "kmeans":
                from statistical.machine_learning import MachineLearning
                results[atype] = MachineLearning.kmeans(df, **params)
            elif atype == "pca":
                from statistical.advanced import AdvancedAnalysis
                results[atype] = AdvancedAnalysis.pca(df, **params)
            else:
                print(f"  Unknown analysis: {atype}")
                continue
            print(f"  Complete")
        except Exception as e:
            print(f"  Failed: {e}")

    output = args.output or "batch_results.json"
    with open(output, "w") as f:
        json.dump(results, f, indent=2, default=str)
    print(f"\nBatch results saved: {output}")


