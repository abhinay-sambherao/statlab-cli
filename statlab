    print("""
StatLab AI - Available Analyses

DESCRIPTIVE STATISTICS
   ./statlab describe <file> [--columns col1 col2]

NORMALITY TESTS
   ./statlab normality <file> --column col

HYPOTHESIS TESTS
   ./statlab ttest <file> --group1 col_a --group2 col_b [--paired]

CORRELATION
   ./statlab correlation <file> [--columns col1 col2] [--method pearson]

ANOVA
   ./statlab anova <file> --dv numeric --factor categorical

REGRESSION
   ./statlab regression <file> --dv target --predictors x1 x2

MACHINE LEARNING
   ./statlab kmeans <file> --clusters 3 [--columns col1 col2]
   ./statlab pca <file> [--components 2]

SIMULATION
   ./statlab monte-carlo --simulations 10000 --distribution normal

REPORT GENERATION
   ./statlab report results.json --format html

BATCH PROCESSING
   ./statlab batch config.json

QUICK REFERENCE
   ./statlab list                    Show this help
   ./statlab upload <file>           Preview a dataset
   ./statlab describe <file> --json  Output JSON for piping

TIP: For large datasets, pipe JSON output:
   ./statlab describe data.csv --json | ./statlab report - --format html
""")


def main():
    parser = argparse.ArgumentParser(
        description="StatLab AI - CLI for large dataset statistical analysis",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  ./statlab upload data.csv
  ./statlab describe large_dataset.csv --columns revenue users --json
  ./statlab ttest experiment.csv --group1 control --group2 treatment --value score
  ./statlab regression sales.csv --dv revenue --predictors marketing spend
  ./statlab kmeans customers.csv --clusters 5
  ./statlab monte-carlo --simulations 50000
  ./statlab batch my_analysis_config.json
  ./statlab list
        """
    )
    subparsers = parser.add_subparsers(dest="command", help="Analysis command")

    p_upload = subparsers.add_parser("upload", help="Upload and preview a dataset")
    p_upload.add_argument("file", help="Path to dataset file")

    p_desc = subparsers.add_parser("describe", help="Descriptive statistics")
    p_desc.add_argument("file", help="Path to dataset file")
    p_desc.add_argument("--columns", nargs="*", help="Columns to analyze")
    p_desc.add_argument("--json", action="store_true", help="Output as JSON")

    p_norm = subparsers.add_parser("normality", help="Normality tests")
    p_norm.add_argument("file", help="Path to dataset file")
    p_norm.add_argument("--column", required=True, help="Column to test")

    p_corr = subparsers.add_parser("correlation", help="Correlation analysis")
    p_corr.add_argument("file", help="Path to dataset file")
    p_corr.add_argument("--columns", nargs="*", help="Columns to analyze")
    p_corr.add_argument("--method", default="pearson", choices=["pearson", "spearman", "kendall"], help="Correlation method")

    p_ttest = subparsers.add_parser("ttest", help="Independent or paired t-test")
    p_ttest.add_argument("file", help="Path to dataset file")
    p_ttest.add_argument("--group1", required=True, help="First group column")
    p_ttest.add_argument("--group2", required=True, help="Second group column")
    p_ttest.add_argument("--paired", action="store_true", help="Paired t-test")
    p_ttest.add_argument("--value", help="Value column (for paired tests)")

    p_anova = subparsers.add_parser("anova", help="One-way ANOVA")
    p_anova.add_argument("file", help="Path to dataset file")
    p_anova.add_argument("--dv", required=True, help="Dependent variable column")
    p_anova.add_argument("--factor", required=True, help="Factor/categorical column")

    p_reg = subparsers.add_parser("regression", help="Linear regression")
    p_reg.add_argument("file", help="Path to dataset file")
    p_reg.add_argument("--dv", required=True, help="Dependent variable")
    p_reg.add_argument("--predictors", nargs="*", help="Predictor columns")

    p_km = subparsers.add_parser("kmeans", help="K-Means clustering")
    p_km.add_argument("file", help="Path to dataset file")
    p_km.add_argument("--clusters", type=int, default=3, help="Number of clusters")
    p_km.add_argument("--columns", nargs="*", help="Columns to use")

    p_pca = subparsers.add_parser("pca", help="Principal Component Analysis")
    p_pca.add_argument("file", help="Path to dataset file")
    p_pca.add_argument("--components", type=int, default=None, help="Number of components")

    p_mc = subparsers.add_parser("monte-carlo", help="Monte Carlo simulation")
    p_mc.add_argument("--simulations", type=int, default=10000, help="Number of simulations")
    p_mc.add_argument("--samples", type=int, default=30, help="Samples per simulation")
    p_mc.add_argument("--distribution", default="normal", choices=["normal", "uniform", "exponential", "binomial", "poisson"])

    p_rpt = subparsers.add_parser("report", help="Generate report from JSON")
    p_rpt.add_argument("file", help="JSON results file")
    p_rpt.add_argument("--format", default="html", choices=["html", "pdf"], help="Output format")
    p_rpt.add_argument("--output", "-o", help="Output filename")

    p_batch = subparsers.add_parser("batch", help="Batch analysis from config")
    p_batch.add_argument("config", help="JSON config file")
    p_batch.add_argument("--output", "-o", default="batch_results.json", help="Output file")

    subparsers.add_parser("list", help="List all analyses and usage")

    args = parser.parse_args()
    if args.command is None:
        parser.print_help()
        sys.exit(1)

    commands = {
        "upload": cmd_upload,
        "describe": cmd_describe,
        "normality": cmd_normality,
        "correlation": cmd_correlation,
        "ttest": cmd_ttest,
        "anova": cmd_anova,
        "regression": cmd_regression,
        "kmeans": cmd_kmeans,
        "pca": cmd_pca,
        "monte-carlo": cmd_monte_carlo,
        "report": cmd_report,
        "batch": cmd_batch,
        "list": cmd_list,
    }

    commands[args.command](args)


if __name__ == "__main__":
    main()
